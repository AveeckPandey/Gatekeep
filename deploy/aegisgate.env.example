# GateKeep Production Environment Configuration (/etc/aegisgate/aegisgate.env)
# Permissions must be restricted: sudo chmod 600 /etc/aegisgate/aegisgate.env
# NOTE: Zero AWS static access keys are stored here.
# AWS credentials are provided dynamically via EC2 IAM Instance Profile (IMDSv2).

ENV=production
APP_NAME=GateKeep
DEBUG=false

# Storage & DynamoDB
REPOSITORY_BACKEND=dynamodb
DYNAMODB_TABLE_NAME=gatekeep-main
AWS_REGION=us-east-1

# Control Plane Auth (JWT)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-cryptographically-secure-random-32-byte-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Upstream LLM Key Encryption at Rest (Fernet key - 32 url-safe base64-encoded bytes)
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GATEKEEP_ENCRYPTION_KEY=replace-with-a-fernet-url-safe-base64-key-here=

# Upstream LLM Default
DEFAULT_UPSTREAM_BASE_URL=https://integrate.api.nvidia.com/v1

# Security Thresholds
ENTROPY_THRESHOLD=3.7
MIN_ENTROPY_STRING_LEN=16
