# ==============================================================================
# GateKeep — Multi-Tenant LLM Security Gateway & Prompt Injection Firewall
# Production & Local Configuration (AWS Free Tier Compatible)
# ==============================================================================

# General Application Settings
APP_NAME="GateKeep"
ENV="production"
DEBUG="false"

# Control Plane Auth (JWT)
# Generate via: openssl rand -hex 32
JWT_SECRET_KEY="replace-with-a-secure-random-32-byte-secret-key"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="1440"

# BYOK Upstream Secret Encryption at Rest (Fernet / AES-256-GCM)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GATEKEEP_ENCRYPTION_KEY="replace-with-32-urlsafe-base64-bytes-fernet-key"

# Default Upstream LLM Endpoint (e.g. NVIDIA Nemotron, OpenAI, etc.)
DEFAULT_UPSTREAM_BASE_URL="https://integrate.api.nvidia.com/v1"

# Database Repository ("dynamodb" for production/local DynamoDB, or "in_memory" for testing)
REPOSITORY_BACKEND="dynamodb"
DYNAMODB_TABLE_NAME="gatekeep-main"
AWS_REGION="us-east-1"

# Optional: Custom DynamoDB Endpoint for DynamoDB Local (Docker)
# DYNAMODB_ENDPOINT_URL="http://localhost:8000"

# Optional: AWS Credentials (if not using IAM Roles or AWS Lambda execution role)
# AWS_ACCESS_KEY_ID="your-aws-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"

# Security Detection Engine Thresholds
ENTROPY_THRESHOLD="3.7"
MIN_ENTROPY_STRING_LEN="16"
